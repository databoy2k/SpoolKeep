# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/

# ── Runtime data (user databases, uploads, logs) ─────────────────────────────
# This directory is created automatically on first run and holds all user data.
# It must never be committed — it contains personal spool inventory, encrypted
# API keys, uploaded STL/3MF files, and server logs.
data/

# ── Build artifacts ───────────────────────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env

# ── Claude Code project settings ─────────────────────────────────────────────
# Contains per-developer tool permissions and approved shell commands.
.claude/

# ── Deployment archives (created by update.ps1 / update.sh) ──────────────────
*.tar.gz

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS / editor files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.sw?
update.ps1
