{
  "name": "spool-keep",
  "version": "1.0.0-beta.3",
  "description": "Lightweight 3D printing filament spool manager, RFID tag writer, and OrcaSlicer profile generator.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "postinstall": "npm install --prefix frontend"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fs-extra": "^11.3.0",
    "multer": "^2.1.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "private": true
}
